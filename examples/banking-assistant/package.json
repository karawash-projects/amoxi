{
  "name": "banking-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "An AI banking assistant: balances, spending insights, transfers with approval, card controls and fee questions.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "amoxi dev",
    "build": "amoxi build && tsc -p tsconfig.json",
    "start": "amoxi start dist/src/main.js --workers 1",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "amoxi": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
